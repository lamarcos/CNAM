pipeline {
    agent any

    environment {
        GITHUB_REPO = 'lamarcos/CNAM' // Remplace par ton dépôt
        GITHUB_TOKEN = credentials('github-token') // Ton token GitHub
        SONARQUBE_ENV = 'SonarQube' // Nom de la configuration SonarQube dans Jenkins
        SONAR_AUTH_TOKEN = credentials('Sonarqube-token') // Ton token SonarQube pour authentification
        SONAR_HOST_URL = 'http://sonarqube:9000' // URL du serveur SonarQube
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm // Vérifie le code depuis le dépôt GitHub
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    withSonarQubeEnv(SONARQUBE_ENV) {
                        // Commande pour analyser le code avec SonarQube en utilisant Docker pour appeler le scanner dans le conteneur SonarQube
                        sh """
                        docker run --rm \
                            -v \$(pwd):/app \
                            sonarqube:latest sonar-scanner \
                            -Dsonar.projectKey=my_project_key \
                            -Dsonar.sources=. \
                            -Dsonar.host.url=${SONAR_HOST_URL} \
                            -Dsonar.login=${SONAR_AUTH_TOKEN}
                        """
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                script {
                    def qualityGate = waitForQualityGate()
                    if (qualityGate.status != 'OK') {
                        githubNotify('failure', 'Analyse échouée par SonarQube.')
                        error 'SonarQube Quality Gate a échoué. Build arrêté.'
                    } else {
                        githubNotify('success', 'Analyse réussie par SonarQube.')
                    }
                }
            }
        }

        stage('OSV-Scanner Analysis') {
            steps {
                script {
                    sh """
                    docker run --rm \
                        -v \$(pwd):/app \
                        osv-scanner:latest --update
                    """
                }
            }
        }
    }

    post {
        success {
            script {
                githubNotify('success', 'Pipeline terminé avec succès. Prêt pour validation manuelle.')
            }
        }
        failure {
            script {
                githubNotify('failure', 'Pipeline échoué. Vérification requise.')
            }
        }
    }
}

def githubNotify(status, description) {
    sh """
    curl -X POST \
        -H "Authorization: token ${GITHUB_TOKEN}" \
        -H "Accept: application/vnd.github.v3+json" \
        https://api.github.com/repos/${GITHUB_REPO}/statuses/${env.GIT_COMMIT} \
        -d '{
            "state": "${status}",
            "description": "${description}",
            "context": "CI/CD Pipeline"
        }'
    """
}
